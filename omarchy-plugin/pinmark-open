#!/usr/bin/env python3
"""Open markdown files in Pinmark (Omarchy plugin)."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

MD_EXT = {".md", ".markdown", ".mdown", ".mkd"}


def state_dir() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME")
    root = Path(xdg) if xdg else Path.home() / ".local" / "state"
    path = root / "omarchy"
    path.mkdir(parents=True, exist_ok=True)
    return path


def read_files(paths: list[str]) -> list[dict[str, str]]:
    out: list[dict[str, str]] = []
    for raw in paths:
        p = Path(raw).expanduser()
        if not p.is_file():
            print(f"pinmark-open: not a file: {raw}", file=sys.stderr)
            continue
        if p.suffix.lower() not in MD_EXT and p.suffix.lower() not in {".txt", ""}:
            print(f"pinmark-open: skipping {p.name}", file=sys.stderr)
            continue
        try:
            text = p.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            text = p.read_text(encoding="utf-8", errors="replace")
        out.append({"path": str(p.resolve()), "name": p.name, "text": text})
    return out


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: pinmark-open FILE.md [FILE.md ...]", file=sys.stderr)
        return 2
    payload = read_files(sys.argv[1:])
    if not payload:
        return 1
    inbox = state_dir() / "pinmark-open.json"
    inbox.write_text(json.dumps(payload, ensure_ascii=False) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
